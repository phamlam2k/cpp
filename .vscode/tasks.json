{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "C:/Program Files/Git/bin/bash.exe",
            "args": ["-c"]
        }
    },
    "tasks": [
        {
            "label": "Build active file",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "'C:/msys64/ucrt64/bin/g++.exe' -std=c++17 -g -Wall -Wextra '${fileBasename}' -o '${fileBasenameNoExtension}.exe'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Chi bien dich file .cpp dang mo (co -g de debug)"
        },
        {
            "label": "Build & Run (input.txt)",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "'C:/msys64/ucrt64/bin/g++.exe' -std=c++17 -O2 -Wall '${fileBasename}' -o '${fileBasenameNoExtension}.exe' && echo '=== OUTPUT ===' && './${fileBasenameNoExtension}.exe' < input.txt",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Bien dich + chay voi input.txt trong cung thu muc"
        },
        {
            "label": "Build & Run (nhap tay)",
            "type": "shell",
            "options": {
                "cwd": "${fileDirname}"
            },
            "command": "'C:/msys64/ucrt64/bin/g++.exe' -std=c++17 -O2 -Wall '${fileBasename}' -o '${fileBasenameNoExtension}.exe' && './${fileBasenameNoExtension}.exe'",
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Bien dich + chay, tu go input tren terminal"
        }
    ]
}
